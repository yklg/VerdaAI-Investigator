[Unit]
Description=青野 Verda Worker (docker compose)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
# 用 docker compose 拉起单容器；oneshot + RemainAfterExit 让 systemd 把「compose up」当作一个长存单元管理
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/verda
ExecStart=/usr/bin/docker compose -f /opt/verda/deploy/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f /opt/verda/deploy/docker-compose.yml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
